# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Use a DEDICATED OpenAI project for the class. Rate limits are enforced at the
# organization AND project level, so a stray script elsewhere in the org can eat
# the class's images — at least make it visible.
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1536
TRANSLATE_MODEL=gpt-4.1-mini
MODERATION_MODEL=omni-moderation-latest

# The account's REAL images-per-minute limit. Tier 1 = 5, Tier 2 = 20.
# Read it: pnpm check:limits   (needs an Admin key, see scripts/check-rate-limit.ts)
OPENAI_IPM=5
MAX_IN_FLIGHT=4
MAX_TRIES=3
# fifo            = strictly first-come-first-served (last student waits ~9 min)
# attempt_priority = everyone's 1st picture before anyone's 2nd (~4.9 min)
QUEUE_ORDER=fifo

# ── Supabase ─────────────────────────────────────────────────────────────────
# NOTE: no NEXT_PUBLIC_ Supabase vars. The browser never holds a Supabase key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=drawings

# ── App ──────────────────────────────────────────────────────────────────────
TEACHER_PASSWORD=change-me
# openssl rand -hex 32
WORKER_SECRET=change-me-to-32-random-hex-chars
APP_URL=https://your-app.vercel.app

POLL_INTERVAL_MS=2500
GALLERY_POLL_MS=5000
DEFAULT_PER_DEVICE_LIMIT=2
DEFAULT_TOTAL_LIMIT=50

# Test affordance only. Never set in production.
# MOCK_OPENAI=1
# MOCK_LATENCY_MS=3000
